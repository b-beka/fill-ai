# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/fill_ai

# Redis
REDIS_URL=redis://redis:6379/0

# S3 / MinIO
S3_ENDPOINT=http://minio:9000
S3_BUCKET=lesson-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MEDIA_URL_MODE=proxy

# LiveKit
LIVEKIT_URL=http://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# External AI Providers (Keys)
SONIOX_API_KEY=dev_soniox_key
GROQ_API_KEY=dev_groq_key
GEMINI_API_KEY=dev_gemini_key

# Models
VLM_MODEL=gemini-3.5-flash-lite
VLM_ESCALATION_MODEL=gemini-3.6-flash
LLM_MODEL=gemini-3.6-flash
LLM_LIGHT_MODEL=gemini-3.5-flash-lite
VLM_FALLBACK_MODEL=
LLM_FALLBACK_MODEL=
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
MODEL_PRICES_JSON={}

# Auth & Security
JWT_ISSUER=fill-ai-auth
JWKS_URL=
JWT_SECRET=dev-secret-fill-ai-backend-2026-super-secure
JWT_ALGORITHM=HS256
CORS_ORIGINS=["*"]

# Budget & Retention
MAX_COST_USD_PER_LESSON=3.0
RAW_RETENTION_DAYS=30

# Frame Detection Thresholds
FRAME_SAMPLE_FPS=1
CHANGE_DIFF_THRESHOLD=0.04
STABLE_DIFF_THRESHOLD=0.01
STABLE_SECONDS=2.0
MIN_LAPLACIAN_VAR=60.0
DEDUP_LAST_N=8
MIN_FRAME_GAP_SEC=4.0
MAX_FRAMES_PER_LESSON=150
MAX_FRAMES_PER_WINDOW=6
BOARD_ACCUMULATION_MIN_AREA=0.03
KEEP_THRESHOLD=0.35

# Window Management Thresholds
WINDOW_TARGET_SEC=240
WINDOW_MIN_SEC=120
WINDOW_MAX_SEC=360
ENABLE_DIAGRAMS=false

# Quiz and Report Settings
AT_RISK_THRESHOLD=0.5
REPORT_AUTO_REFRESH_HOURS=24
FILE_PROCESSING_CONCURRENCY=4

# Concurrency & Rate Limiting
GEMINI_MAX_CONCURRENCY=5
SONIOX_MAX_STREAMS=5
RATE_LIMIT_PER_MINUTE=60
MAX_SSE_PER_USER=5
